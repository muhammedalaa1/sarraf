{
  "name": "sarraf-monorepo",
  "private": true,
  "type": "module",
  "description": "One payment API for Egypt and the Middle East: Paymob, Kashier, Fawry.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=12"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:sandbox": "vitest run --config vitest.sandbox.config.ts",
    "typecheck": "turbo run typecheck && tsc -p tsconfig.json",
    "lint": "biome check . && eslint",
    "format": "biome format --write .",
    "check-secrets": "tsx scripts/check-no-secrets.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "changeset": "changeset",
    "release": "turbo run build --filter=./packages/* && changeset publish",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "lint:fix": "biome check --write . && eslint --fix",
    "lint:packages": "turbo run lint:package --filter=./packages/*",
    "check": "pnpm build && pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts && pnpm lint:packages && pnpm check-secrets",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@biomejs/biome": "2.5.15",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@sarrafjs/core": "workspace:*",
    "@sarrafjs/fawry": "workspace:*",
    "@sarrafjs/kashier": "workspace:*",
    "@sarrafjs/paymob": "workspace:*",
    "@sarrafjs/testing": "workspace:*",
    "@types/node": "26.6.5",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "18.0.8",
    "eslint": "10.13.0",
    "expect-type": "1.4.0",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "turbo": "2.11.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
