{
  "name": "@sarrafjs/nestjs",
  "version": "0.2.0",
  "description": "NestJS module for Sarraf: an injectable client, a verified webhook controller and @OnSarrafEvent() handlers.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammedalaa1/sarraf.git",
    "directory": "packages/nestjs"
  },
  "keywords": [
    "nestjs",
    "webhooks",
    "payments",
    "sarraf"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict"
  },
  "dependencies": {
    "@sarrafjs/core": "workspace:^"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10",
    "@nestjs/core": ">=10"
  },
  "devDependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/testing": "12.2.0",
    "@sarrafjs/testing": "workspace:*",
    "@types/supertest": "7.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "supertest": "7.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
