{
  "name": "@sarrafjs/next",
  "version": "0.2.1",
  "description": "Next.js App Router helpers for Sarraf: a verified webhook route handler and redirect verification.",
  "homepage": "https://sarraf-docs.vercel.app/guides/nextjs/",
  "bugs": {
    "url": "https://github.com/muhammedalaa1/sarraf/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammedalaa1/sarraf.git",
    "directory": "packages/next"
  },
  "keywords": [
    "nextjs",
    "route-handler",
    "webhooks",
    "payments",
    "sarraf"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict"
  },
  "dependencies": {
    "@sarrafjs/core": "workspace:^"
  },
  "devDependencies": {
    "@sarrafjs/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
