{
  "name": "@sarrafjs/kashier",
  "version": "0.2.0",
  "description": "Kashier adapter for Sarraf: hosted payment page, redirect and webhook signature verification.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammedalaa1/sarraf.git",
    "directory": "packages/kashier"
  },
  "keywords": [
    "kashier",
    "payments",
    "egypt",
    "sarraf"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./testing": {
      "import": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "require": {
        "types": "./dist/testing.d.cts",
        "default": "./dist/testing.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict"
  },
  "dependencies": {
    "@sarrafjs/core": "workspace:^",
    "query-string": "9.5.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@sarrafjs/testing": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
