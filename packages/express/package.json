{
  "name": "@sarrafjs/express",
  "version": "0.1.0",
  "description": "Express helpers for Sarraf: raw-body middleware and a verified webhook handler.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhammedalaa1/sarraf.git",
    "directory": "packages/express"
  },
  "keywords": [
    "express",
    "webhooks",
    "payments",
    "sarraf"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint:package": "publint --strict"
  },
  "dependencies": {
    "@sarrafjs/core": "workspace:^"
  },
  "peerDependencies": {
    "express": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sarrafjs/testing": "workspace:*",
    "@types/express": "5.0.6",
    "@types/supertest": "7.2.1",
    "express": "5.3.0",
    "supertest": "7.3.1"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
