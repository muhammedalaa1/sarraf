{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.next",
      "!**/coverage",
      "!**/node_modules",
      "!**/.astro",
      "!**/.turbo",
      "!**/next-env.d.ts",
      "!**/fixtures",
      "!**/test/fixtures",
      "!**/apps/docs/public/api",
      "!**/apps/docs/src/content/docs/api"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 110
  },
  "markdown": { "formatter": { "enabled": false } },
  "yaml": { "formatter": { "enabled": false } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedPrivateClassMembers": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": "off",
        "noEmptyBlockStatements": "error",
        "noEvolvingTypes": "error",
        "noMisplacedAssertion": "error",
        "useAwait": "off",
        "noSkippedTests": "off",
        "noFocusedTests": "error",
        "noDoubleEquals": "error",
        "noVar": "error"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useTemplate": "off",
        "useImportType": "error",
        "useExportType": "error",
        "useNodejsImportProtocol": "error",
        "useConst": "error",
        "noParameterAssign": "error",
        "useShorthandFunctionType": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "noInferrableTypes": "error",
        "noUselessElse": "error",
        "useThrowNewError": "error",
        "useThrowOnlyError": "error"
      },
      "complexity": {
        "noForEach": "off",
        "noUselessTypeConstraint": "error",
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 25
          }
        }
      },
      "security": {
        "noGlobalEval": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/packages/**/*/src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "error"
          },
          "style": {
            "noNonNullAssertion": "error",
            "noDefaultExport": "error"
          }
        }
      }
    },
    {
      "includes": ["**/packages/core/src/logger.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/test/**", "**/*.test.ts", "**/*.test.tsx"],
      "linter": {
        "rules": {
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "javascript": {
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  }
}
