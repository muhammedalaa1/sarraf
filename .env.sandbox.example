# Copy to .env.sandbox (gitignored) and fill in SANDBOX / TEST credentials only.
# Never put live keys here. scripts/check-no-secrets.ts fails CI if any of these values leak into the repo.

# ── Paymob (Dashboard → Settings / Developers) ─────────────────────────────
PAYMOB_REGION=egypt
PAYMOB_SECRET_KEY=sk_test_...
PAYMOB_PUBLIC_KEY=pk_test_...
PAYMOB_HMAC_SECRET=
PAYMOB_API_KEY=
# Integration ids (Settings → Payment Integrations, test mode). Card and wallet are enough to start.
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
# Kiosk (Aman / Masary bill reference)
PAYMOB_KIOSK_INTEGRATION_ID=
# Card integration in Auth mode, for manual capture
PAYMOB_CARD_AUTH_INTEGRATION_ID=
# MOTO integration, for charging saved cards and subscription renewals
PAYMOB_CARD_MOTO_INTEGRATION_ID=
# Live-only in Paymob: leave empty in the sandbox
PAYMOB_APPLE_PAY_INTEGRATION_ID=
PAYMOB_BNPL_INTEGRATION_ID=
PAYMOB_INSTALLMENTS_INTEGRATION_ID=
# Optional: a paid sandbox transaction id, for status / refund contract tests
PAYMOB_SANDBOX_TRANSACTION_ID=
# Optional: an uncaptured authorization (card_auth checkout), for the capture contract test
PAYMOB_SANDBOX_AUTH_TRANSACTION_ID=

# ── Kashier (Merchant dashboard → Integrate now) ───────────────────────────
KASHIER_MERCHANT_ID=MID-...
KASHIER_API_KEY=
KASHIER_SECRET_KEY=
# Optional: the reference (your merchantOrderId) of a paid test order, for the order lookup contract test
KASHIER_SANDBOX_REFERENCE=

# ── Fawry (staging) ────────────────────────────────────────────────────────
FAWRY_MERCHANT_CODE=
FAWRY_SECURE_KEY=

# ── Local webhook capture (scripts/record-fixtures.ts webhook ...) ────────
# Public HTTPS URL of your tunnel (cloudflared / ngrok) pointing at localhost:4545
SANDBOX_PUBLIC_URL=https://your-tunnel.trycloudflare.com
